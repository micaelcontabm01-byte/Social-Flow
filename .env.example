# SocialFlow - variaveis de ambiente
# Copie este arquivo para .env e preencha os valores

PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Supabase Postgres - pegar em Project Settings > Database > Connection string (Transaction Pooler)
DATABASE_URL=postgresql://postgres.xxxx:senha@aws-0-region.pooler.supabase.com:6543/postgres

# Sessao - gere uma string aleatoria longa (ex: openssl rand -base64 48)
SESSION_SECRET=troque_isso_por_uma_string_aleatoria_de_no_minimo_32_caracteres

# Anthropic Claude (IA para gerar persona, roteiro, copy de carrossel)
ANTHROPIC_API_KEY=sk-ant-...

# Lastlink - token configurado no painel da Lastlink (header X-Lastlink-Token)
LASTLINK_WEBHOOK_SECRET=

# Lastlink - IDs dos produtos por plano (pega no painel Lastlink apos criar cada oferta)
LASTLINK_PRODUCT_STARTER=
LASTLINK_PRODUCT_PRO=
LASTLINK_PRODUCT_AGENCY=

# Lastlink - URLs de checkout por plano
LASTLINK_CHECKOUT_STARTER=
LASTLINK_CHECKOUT_PRO=
LASTLINK_CHECKOUT_AGENCY=

# Resend (emails transacionais - notificacao de aprovacao)
RESEND_API_KEY=

# Email de envio (precisa de dominio verificado no Resend ou usar onboarding@resend.dev pra testes)
RESEND_FROM_EMAIL=SocialFlow <onboarding@resend.dev>
