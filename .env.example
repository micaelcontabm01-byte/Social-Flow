# SocialFlow - variaveis de ambiente
# Copie este arquivo para .env e preencha os valores

PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Supabase Postgres - pegar em Project Settings > Database > Connection string (Transaction Pooler)
DATABASE_URL=postgresql://postgres.xxxx:senha@aws-0-region.pooler.supabase.com:6543/postgres

# Sessao - gere uma string aleatoria longa (ex: openssl rand -base64 48)
SESSION_SECRET=troque_isso_por_uma_string_aleatoria_de_no_minimo_32_caracteres

# Anthropic Claude (IA para gerar persona, roteiro, copy de carrossel)
ANTHROPIC_API_KEY=sk-ant-...

# Lastlink - token configurado no painel da Lastlink (header X-Lastlink-Token)
LASTLINK_WEBHOOK_SECRET=

# Lastlink - IDs dos produtos por plano (pega no painel Lastlink apos criar cada oferta)
LASTLINK_PRODUCT_SOLO=
LASTLINK_PRODUCT_PRO=
LASTLINK_PRODUCT_BLACK=

# Lastlink - URLs de checkout por plano
LASTLINK_CHECKOUT_SOLO=
LASTLINK_CHECKOUT_PRO=
LASTLINK_CHECKOUT_BLACK=

# Resend (emails transacionais - notificacao de aprovacao)
RESEND_API_KEY=

# Email de envio (precisa de dominio verificado no Resend ou usar onboarding@resend.dev pra testes)
RESEND_FROM_EMAIL=SocialFlow <onboarding@resend.dev>

# Grupo VIP no WhatsApp dos clientes BLACK (link de convite)
# Cole o link gerado em "Convidar via link" do grupo do WhatsApp
BLACK_WHATSAPP_GROUP_URL=

# Segredo do Vercel Cron - gere uma string aleatoria longa (openssl rand -base64 32)
# Configure tambem no Vercel: Settings > Cron Jobs (Authorization automatica)
CRON_SECRET=

# ============================================================
# INTEGRACOES (Notion + Google Drive) - export de roteiros/carrosseis
# ============================================================
# Chave pra encriptar os tokens das integracoes no banco (qualquer string longa,
# gere com: openssl rand -base64 48). NUNCA troque depois de ter integracoes
# conectadas - isso invalida todos os tokens ja salvos.
INTEGRATIONS_ENC_KEY=

# Notion - criar "public integration" em https://www.notion.so/my-integrations
# Em OAuth Domain & URIs, adicione o redirect: {APP_URL}/api/integrations/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Google - criar OAuth Client (tipo Web) em https://console.cloud.google.com/apis/credentials
# Ative a "Google Drive API". Escopo usado: drive.file (so arquivos criados pelo app).
# Authorized redirect URI: {APP_URL}/api/integrations/google_drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
